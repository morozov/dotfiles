[core]
	pager = less -x4
	ignorecase = false

	# See https://stackoverflow.com/questions/34549040/git-not-displaying-unicode-file-names
	quotePath = false
[user]
	name = Sergei Morozov
	email = morozovby@gmail.com
[include]
	path = ~/.gitconfig
[color]
	ui = auto
[alias]
	pr = "!f() { git fetch -f "upstream pull/$1/head:pull/$1" && git checkout "pull/$1"; }; f"
	lg = "log --pretty=format:'%Cred%h%Creset%C(yellow)%d%Creset %<(48,mtrunc)%s %Cgreen(%cr) %C(bold blue)<%an>%Creset'"
[log]
	decorate = short
[diff]
	algorithm = patience
	colorMoved = default
	compactionHeuristic = true
[rebase]
	abbreviateCommands = true
	missingCommitsCheck = error
	autostash = true
	autosquash = true
[remote "origin"]
	prune = true
[url "ssh://git@heroku.com/"]
	insteadOf = https://git.heroku.com/
[url "git@github.com:"]
	insteadOf = https://github.com/
[column]
	ui = auto
[branch]
	sort = -committerdate
[tag]
	sort = version:refname
[status]
	relativePaths = true
[pull]
	ff = only
[push]
	autoSetupRemote = true
	default = upstream
[init]
	defaultBranch = main
[advice]
	detachedHead = false
[fetch]
	prune = true
	all = true
[rerere]
	enabled = true
	autoupdate = true
[hook "rule72"]
	# Trailing '#' discards the arguments git appends as "$@"; without it the
	# mv gets a third argument and fails. A missing rule72 aborts the commit.
	command = "rule72 < \"$1\" > \"$1.r72\" && mv \"$1.r72\" \"$1\" || { rm -f \"$1.r72\"; false; } #"
	event = commit-msg
